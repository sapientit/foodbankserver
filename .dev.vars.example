# Copy to `.dev.vars` for local development. `.dev.vars` is gitignored.
#
# In deployed environments these are Worker secrets, set with:
#   npx wrangler secret put AUTH_JWT_SECRET --env production
#
# Generate a value with:
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"

AUTH_JWT_SECRET=replace-me-with-at-least-32-random-characters

# Optional in development. REQUIRED in production - the Worker refuses to start
# without it, because the referral endpoint is an open write storing personal
# data. Create a Turnstile widget in the Cloudflare dashboard to get one.
# TURNSTILE_SECRET_KEY=

# Comma-separated origins the React app is served from. Empty means
# same-origin only.
# ALLOWED_ORIGINS=http://localhost:5173

# Unset means personal data is never purged. Set only once the charity has
# agreed a retention period.
# PII_RETENTION_DAYS=730

# Overrides wrangler.jsonc's top-level GOOGLE_SHEETS_SPREADSHEET_ID for local
# `wrangler dev` only (.dev.vars wins over `vars` there). Without this, local
# dev shares a spreadsheet with the deployed test system
# (api-test.guildfordfoodbank.workers.dev) — same reasoning as test vs.
# production having different values: a dev run must not write into rows the
# deployed test system, or someone testing against it, is relying on.
# GOOGLE_SHEETS_SPREADSHEET_ID=

# Overrides wrangler.jsonc's top-level AUTH_MODE for local `wrangler dev` only.
# The deployed test system signs on with real Google identities; local dev has
# no browser flow to produce a real Google ID token, so it stays on the dummy
# provider regardless. Uncomment if your wrangler.jsonc's default ever changes.
# AUTH_MODE=dummy

# TheSMSWorks. Outside production a real key texts ONLY the numbers in
# SMS_LIVE_NUMBERS - unset means nobody, and every other send falls back to
# SMS_SIMULATE (on in wrangler.jsonc's dev vars). Production texts everyone and
# refuses SMS_LIVE_NUMBERS.
# SMS_API_KEY=
# SMS_SENDER=
# SMS_LIVE_NUMBERS=07700 900123,07700 900456
